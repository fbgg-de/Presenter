          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/SongCategory"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/MetaCount"
                    }
                  },
                  "required": ["data", "meta"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get all song categories",
        "tags": ["Song"]
      },
      "post": {
        "description": "Creates a song category from the provided master-data fields.",
        "operationId": "post-song-categories",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SongCategoryWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SongCategory"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "Song category created"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          }
        },
        "summary": "Create a song category",
        "tags": ["Song"]
      }
    },
