    "/songs": {
      "get": {
        "description": "Get all Songs. Only those songs are returned that the user has permission to view.",
        "operationId": "get-songs",
        "parameters": [
          {
            "description": "Filter response by category IDs.",
            "explode": true,
            "in": "query",
            "name": "song_category_ids[]",
            "schema": {
              "example": [1],
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          },
          {
            "description": "Filter by Song IDs.",
            "explode": true,
            "in": "query",
            "name": "ids[]",
            "schema": {
              "example": [5, 12],
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          },
          {
            "description": "Filter by field `shouldPractice`.",
            "in": "query",
            "name": "practice",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "Filter by arrangement key. Song plus all its arrangements are returned if one arrangement meets the filter criterion.",
            "in": "query",
            "name": "key_of_arrangement",
            "schema": {
              "$ref": "#/components/schemas/ArrangementKey"
            }
          },
          {
            "description": "Search by song title.",
            "in": "query",
            "name": "name",
            "schema": {
              "example": "Amazing Grace",
              "type": "string"
            }
          },
          {
            "description": "Search by song title or author.",
            "in": "query",
            "name": "query",
            "schema": {
              "example": "Grace",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/SongInclude"
          },
          {
            "$ref": "#/components/parameters/PageParameter"
          },
          {
            "$ref": "#/components/parameters/LimitParameter"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Song"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/MetaPagination"
                    }
                  },
                  "required": ["data", "meta"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          }
        },
        "summary": "Get all songs",
        "tags": ["Song"]
      },
