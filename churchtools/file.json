{
  "openapi": "3.1.0",
  "info": {
    "contact": {
      "email": "support@churchtools.de",
      "name": "German ChurchTools Forum",
      "url": "https://forum.church.tools/category/22/churchtools-schnittstellen"
    },
    "description": "The ChurchTools REST API is the best entry point for developers to access ChurchTools. <br><br> **Authentication:** You need to be authorized to use some endpoints. Those endpoints are marked by a gray lock symbol. If you view the documentation, while you are logged into ChurchTools, all requests are already authorized. If you want to authorized a request, you need to provide a `Login Token` as `Authorization` header in the format `Authorization: Login <token>` or send a valid cookie. You can use the green \"Authorize\" dialog to enter those details and see how a request would look like in detail. <br><br> **Missing Endpoints:** Not all features are yet available by our new REST API. This documentation will grow in the future. We are working hard to add new endpoints with every ChurchTools version. The documentation will always show only those endpoints you can use with your ChurchTools installation.",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "title": "ChurchTools REST API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "description": "ChurchTools",
      "url": "/api"
    },
    {
      "description": "Local",
      "url": "http://churchtools.test/api"
    }
  ],
  "security": [
    {
      "Login-Token-Header": []
    }
  ],
  "tags": [
    {
      "description": "CRUD methods for files",
      "name": "File"
    }
  ],
  "paths": {
    "/files/{domainType}": {
      "get": {
        "description": "Returns all files for the given domain type that are visible to the current user. Files marked as visible only while editable are omitted if the current user cannot edit files of that domain type.",
        "operationId": "get-files-domainType",
        "parameters": [
          {
            "$ref": "#/components/parameters/DomainType"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/CtFile"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          }
        },
        "summary": "Get all files for a domain type",
        "tags": ["File"]
      }
    },
    "/files/{domainType}/{domainIdentifier}": {
      "delete": {
        "description": "Deletes all files that belong to the given domain object.",
        "operationId": "delete-files-domainType-domainIdentifier",
        "responses": {
          "204": {
            "$ref": "#/components/responses/204-Deleted"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Delete files that are matching the domainType and domainIdentifier",
        "tags": ["File"]
      },
      "get": {
        "description": "Returns all files that belong to the given domain object.",
        "operationId": "get-files-domainType-domainIdentifier",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/CtFile"
                      },
                      "type": "array"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Get all files for a specific domain object",
        "tags": ["File"]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainType"
        },
        {
          "$ref": "#/components/parameters/DomainIdentifier"
        }
      ],
      "patch": {
        "description": "Renames all files for the given domain object or updates their sort key.",
        "operationId": "patch-files-domainType-domainIdentifier",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "New display name for all files of this domain object",
                    "example": "Updated attachment name",
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  },
                  "sortKey": {
                    "description": "New sort key for all files of this domain object",
                    "example": 10,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "$ref": "#/components/responses/204-NoContent"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Update files for a domain object",
        "tags": ["File"]
      },
      "post": {
        "description": "Uploads one or more files for the given domain object.",
        "operationId": "post-files-domainType-domainIdentifier",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "files[]": {
                    "description": "Files to upload",
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "image_options": {
                    "description": "Optional image crop and focus settings",
                    "type": "object"
                  },
                  "max_height": {
                    "description": "Maximum image height in pixels",
                    "type": "string"
                  },
                  "max_width": {
                    "description": "Maximum image width in pixels",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/CtFile"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/MetaCount"
                    }
                  },
                  "required": ["data", "meta"],
                  "type": "object"
                }
              }
            },
            "description": "return new files"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Upload files",
        "tags": ["File"]
      }
    },
    "/files/{domainType}/{domainIdentifier}/link": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainType"
        },
        {
          "$ref": "#/components/parameters/DomainIdentifier"
        }
      ],
      "post": {
        "description": "Adds the given external link to the specified domain object.",
        "operationId": "post-files-domainType-domainIdentifier-link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "Optional display name for the link",
                    "example": "Example Link",
                    "maxLength": 255,
                    "type": ["string", "null"]
                  },
                  "securityLevelId": {
                    "description": "Optional security level for the link",
                    "example": 2,
                    "type": ["integer", "null"]
                  },
                  "url": {
                    "description": "URL to store as link",
                    "example": "https://www.example.com",
                    "maxLength": 255,
                    "type": "string"
                  }
                },
                "required": ["url"],
                "type": "object"
              }
            }
          },
          "description": "Link data",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CtFile"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "The newly created link"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Add link",
        "tags": ["File"]
      }
    },
    "/files/{fileId}/metadata": {
      "get": {
        "deprecated": true,
        "operationId": "get-files-id-metadata",
