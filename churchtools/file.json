      "parameters": [
        {
          "in": "path",
          "name": "fileId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/files/{id}": {
      "delete": {
        "description": "Deletes the file with the given ID.",
        "operationId": "delete-files-id",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/204-Deleted"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Delete a file by ID",
        "tags": ["File"]
      },
      "patch": {
        "description": "Updates metadata for the file with the given ID. Provide `name` to rename the file, `sortKey` to change its sort order, or `copyTo` to copy the file to another domain object.",
        "operationId": "patch-files-id",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "copyTo": {
                    "description": "Optional target domain object to copy this file to",
                    "properties": {
                      "domainId": {
                        "description": "Target domain identifier",
                        "example": "1",
                        "type": "string"
                      },
                      "domainType": {
                        "description": "Target domain type",
                        "example": "person",
                        "type": "string"
                      }
                    },
                    "required": ["domainId", "domainType"],
                    "type": "object"
                  },
                  "name": {
                    "description": "New display name for the file",
                    "example": "screenshot.jpeg",
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  },
                  "sortKey": {
                    "description": "New sort key for the file",
                    "example": 10,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "$ref": "#/components/responses/204-NoContent"
          },
          "400": {
            "$ref": "#/components/responses/400-BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Update file metadata by ID",
        "tags": ["File"]
      }
    },
    "/files/{id}/meta": {
      "get": {
        "description": "Returns metadata for the file with the given ID.",
        "operationId": "get-files-id-meta",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CtFile"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "$ref": "#/components/responses/401-Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/403-Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Get file metadata by ID",
        "tags": ["File"]
      }
    },
    "/images/{fileId}/{hash}": {
      "get": {
        "description": "Returns the image with the given file ID and hash. Optional query parameters are passed to the League Glide image manipulation service; see the Glide documentation for supported manipulation parameters such as `w`, `h`, `fit`, `crop`, `fm`, and `q`. ChurchTools also supports `crop=original` to bypass the stored crop. The requested output format can also be supplied as a suffix on the hash, for example `{hash}.webp`.",
        "externalDocs": {
          "description": "League Glide manipulation parameters",
          "url": "https://glide.thephpleague.com/3.0/api/quick-reference/"
        },
        "operationId": "get-images-fileId-hash",
        "parameters": [
          {
            "description": "ID of the image file",
            "in": "path",
            "name": "fileId",
            "required": true,
            "schema": {
              "example": 985,
              "type": "integer"
            }
          },
          {
            "description": "Hash of the image file, optionally suffixed with an output format",
            "in": "path",
            "name": "hash",
            "required": true,
            "schema": {
              "example": "939a6896d5de0314d8a38de6b5125195e7b15a834b9af78022d061ce6a829e16",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/avif": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/gif": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/heic": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/jpeg": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/tiff": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Image binary",
            "headers": {
              "Content-Disposition": {
                "description": "Provides the original file name as suggested filename. Includes `filename*` for UTF-8 names.",
                "schema": {
                  "example": "inline; filename=\"M_ller.webp\"; filename*=UTF-8''M%C3%BCller.webp",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Get a public image",
        "tags": ["File"]
      }
    },
    "/images/{fileId}/{hash}/{queryParams}": {
      "get": {
        "description": "Returns the image with the given file ID and hash. The `queryParams` path parameter contains URL-encoded image manipulation parameters in the same format as a regular query string, for example `fm%3Dwebp%26q%3D80%26w%3D700%26h%3Dauto`. Only the path-encoded parameters are used; additional query parameters are ignored. The parameters are passed to the League Glide image manipulation service; see the Glide documentation for supported manipulation parameters such as `w`, `h`, `fit`, `crop`, `fm`, and `q`. ChurchTools also supports `crop=original` to bypass the stored crop. The requested output format can also be supplied as a suffix on the hash, for example `{hash}.webp`.",
        "externalDocs": {
          "description": "League Glide manipulation parameters",
          "url": "https://glide.thephpleague.com/3.0/api/quick-reference/"
        },
        "operationId": "get-images-fileId-hash-queryParams",
        "parameters": [
          {
            "description": "ID of the image file",
            "in": "path",
            "name": "fileId",
            "required": true,
            "schema": {
              "example": 985,
              "type": "integer"
            }
          },
          {
            "description": "Hash of the image file, optionally suffixed with an output format",
            "in": "path",
            "name": "hash",
            "required": true,
            "schema": {
              "example": "939a6896d5de0314d8a38de6b5125195e7b15a834b9af78022d061ce6a829e16",
              "type": "string"
            }
          },
          {
            "description": "URL-encoded image manipulation query string. It is interpreted like the query parameters of `/images/{fileId}/{hash}`. Additional query parameters on this route are ignored.",
            "in": "path",
            "name": "queryParams",
            "required": true,
            "schema": {
              "example": "fm%3Dwebp%26q%3D80%26w%3D700%26h%3Dauto",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/avif": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/gif": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/heic": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/jpeg": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/tiff": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/webp": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Image binary",
            "headers": {
              "Content-Disposition": {
                "description": "Provides the original file name as suggested filename. Includes `filename*` for UTF-8 names.",
                "schema": {
                  "example": "inline; filename=\"M_ller.webp\"; filename*=UTF-8''M%C3%BCller.webp",
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404-NotFound"
          }
        },
        "summary": "Get a public image with path-encoded parameters",
        "tags": ["File"]
      }
    },
    "/images/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "patch": {
        "description": "Sets additional information on the image, like annotation, AI generation status, cropping, and focus point",
        "operationId": "patch-images-id",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "aiGenerated": {
                    "description": "Whether the image was generated by artificial intelligence.",
                    "example": false,
                    "type": "boolean"
                  },
                  "annotation": {
                    "example": "Sample Annotation",
                    "maxLength": 200,
                    "type": ["string", "null"]
                  },
                  "annotationLink": {
                    "example": "https://churchtools.test",
                    "maxLength": 300,
                    "type": ["string", "null"]
                  },
                  "description": {
                    "example": "Sample Description",
                    "maxLength": 1000,
                    "type": ["string", "null"]
                  },
                  "options": {
                    "example": "{\"crop\":{\"top\":\"0.0\",\"left\":\"0.0\",\"bottom\":\"0.0\",\"right\":\"0.4\"},\"focus\":{\"x\":\"0.5\",\"y\":\"0.5\"}}",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "aiGenerated": {
                          "description": "Whether the image was generated by artificial intelligence.",
                          "example": false,
                          "type": "boolean"
                        },
                        "annotation": {
                          "type": ["string", "null"]
                        },
                        "annotationLink": {
                          "type": ["string", "null"]
                        },
                        "description": {
                          "type": ["string", "null"]
                        },
                        "domainIdentifier": {
                          "type": "string"
                        },
                        "domainType": {
                          "type": "string"
                        },
                        "filename": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "securityLevelId": {
                          "type": "integer"
                        },
                        "size": {
                          "type": "integer"
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "annotation",
                        "annotationLink",
