                      "type": "string"
                    },
                    "deletion_date": {
                      "type": "string"
                    },
                    "domain_id": {
                      "type": "string"
                    },
                    "domain_type": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "image_options": {
                      "type": "string"
                    },
                    "modified_date": {
                      "type": "string"
                    },
                    "modified_pid": {
                      "type": "string"
                    },
                    "securitylevel_id": {
                      "type": "string"
                    },
                    "showonlywheneditable_yn": {
                      "type": "string"
                    },
                    "sortkey": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "bezeichnung": "intern.church.tools.jpeg",
                      "deletion_date": null,
