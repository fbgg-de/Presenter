  "components": {
    "parameters": {
      "DomainIdentifier": {
        "description": "the domain identifier",
        "in": "path",
        "name": "domainIdentifier",
        "required": true,
        "schema": {
          "example": "35",
          "type": "string"
        }
      },
      "DomainType": {
        "description": "The domain type. Currently supported are 'avatar', 'groupimage', 'appointment_image', 'logo', 'attachments', 'bulkletter_template', 'service', 'song_arrangement', 'importtable', 'person', 'familyavatar', 'post', 'wiki_.?'.",
        "in": "path",
        "name": "domainType",
        "required": true,
        "schema": {
          "example": "logo",
          "type": "string"
        }
      },
      "Id": {
        "description": "ID of Entity",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "example": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "204-Deleted": {
        "description": "Successfully deleted"
      },
      "204-NoContent": {
        "description": "No Content"
      },
      "400-BadRequest": {
        "description": "Bad Request"
      },
      "401-Unauthorized": {
        "content": {
          "text/plain": {
            "schema": {
              "example": "Session expired!",
              "type": "string"
            }
          }
        },
        "description": "Unauthorized"
      },
      "403-Forbidden": {
        "description": "Forbidden to see, create, update, or delete resource"
      },
      "404-NotFound": {
        "description": "Resource not found"
      }
    },
    "schemas": {
      "Color": {
        "description": "Value for Tailwind color",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/CtColor"
          },
          "shade": {
            "enum": [100, 200, 300, 400, 50, 500, 600, 700, 800, 900, null],
            "example": 500,
            "type": ["integer", "null"]
          }
        },
        "required": ["key", "shade"],
        "title": "Color",
        "type": "object"
      },
      "CtColor": {
        "description": "A color in ChurchTools",
        "enum": [
          "accent",
          "amber",
          "basic",
          "blue",
          "constructive",
          "critical",
          "cyan",
          "destructive",
          "emerald",
          "error",
          "fuchsia",
          "green",
          "indigo",
          "info",
          "lime",
          "magic",
          "orange",
          "pink",
          "purple",
          "red",
          "rose",
          "sky",
          "success",
          "teal",
          "violet",
          "warning",
          "yellow"
        ],
        "example": "accent",
        "type": "string"
      },
      "CtFile": {
        "properties": {
          "additionalInfos": {
            "additionalProperties": true,
            "description": "Domain-specific extra data. Empty for most files (serialized as an empty array), but some domains add a key-value object (e.g. statement uploads return `{ \"statementId\": 1 }`).",
            "type": ["object", "array"]
          },
          "aiGenerated": {
            "description": "Whether the image was generated by artificial intelligence.",
            "example": false,
            "type": "boolean"
          },
          "annotation": {
            "type": ["string", "null"]
          },
          "annotationLink": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "domainId": {
            "type": "string"
          },
          "domainType": {
            "type": "string"
          },
          "fileUrl": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "imageMetadata": {
            "description": "Read-only image dimensions calculated from the file. Cannot be modified via API.",
            "properties": {
              "aspectRatio": {
                "type": "number"
              },
              "height": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              }
            },
            "type": ["object", "null"]
          },
          "imageOption": {
            "properties": {
              "crop": {
                "properties": {
                  "bottom": {
                    "type": "number"
                  },
                  "left": {
                    "type": "number"
                  },
                  "right": {
                    "type": "number"
                  },
                  "top": {
                    "type": "number"
                  }
                },
                "required": ["top", "left", "bottom", "right"],
                "type": "object"
              },
              "focus": {
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": ["x", "y"],
                "type": "object"
              }
            },
            "required": ["crop", "focus"],
            "type": ["object", "null"]
          },
          "imageUrl": {
            "type": ["string", "null"]
          },
          "meta": {
            "$ref": "#/components/schemas/FileMetaData"
          },
          "name": {
            "type": "string"
          },
          "relativeUrl": {
            "type": "string"
          },
          "securityLevelId": {
            "type": ["integer", "null"]
          },
          "showOnlyWhenEditable": {
            "type": "boolean"
          },
          "size": {
            "description": "The file size in byte",
            "type": ["integer", "null"]
          },
          "type": {
            "enum": ["file", "link"],
            "type": "string"
          }
        },
        "required": [
          "id",
          "domainType",
          "domainId",
          "name",
          "filename",
          "fileUrl",
          "imageUrl",
          "relativeUrl",
          "showOnlyWhenEditable",
          "securityLevelId",
          "description",
          "annotation",
          "annotationLink",
          "aiGenerated",
          "imageOption",
          "imageMetadata",
          "type",
          "size",
          "meta"
        ],
        "type": "object"
      },
      "DateStringNullable": {
        "description": "A simple date in ISO format, e.g. '2022-10-19'",
        "example": "2022-10-19",
        "format": "date",
        "type": ["string", "null"]
      },
      "DomainObject": {
        "description": "Compact, domain-independent representation for displaying a link to a ChurchTools object. It is not the full resource returned by the object’s own API.",
        "properties": {
          "apiUrl": {
            "description": "URL for the full API resource, if available. Some legacy domain implementations produce inconsistent URLs.",
            "type": ["string", "null"]
          },
          "color": {
            "description": "Optional display color.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Color"
              },
              {
                "$ref": "#/components/schemas/CtColor"
              },
              {
                "type": "null"
              }
            ]
          },
          "domainIdentifier": {
            "description": "Opaque identifier within the domain; do not assume that every domain uses a numeric ID.",
            "type": "string"
          },
          "imageUrl": {
            "description": "Optional image URL.",
            "type": ["string", "null"]
          },
          "infos": {
            "description": "Additional localized display lines; not structured resource fields.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "initials": {
            "description": "Optional initials for an avatar fallback.",
            "type": ["string", "null"]
          },
          "title": {
            "description": "Display title of the referenced object.",
            "type": "string"
          }
        },
        "required": ["domainIdentifier", "title"],
        "type": "object"
      },
      "DomainObjectPerson": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DomainObject"
          },
          {
            "properties": {
              "apiUrl": {
                "type": "string"
              },
              "domainAttributes": {
                "properties": {
                  "dateOfDeath": {
                    "$ref": "#/components/schemas/DateStringNullable"
                  },
                  "firstName": {
                    "example": "Vanessa",
                    "type": "string"
                  },
                  "guid": {
                    "description": "Globally Unique Identifier",
                    "example": "D7AC4C66-8DA4-405A-B492-39B5870D2DB6",
                    "type": ["string", "null"]
                  },
                  "isArchived": {
                    "type": "boolean"
                  },
                  "lastName": {
                    "example": "Fischer",
                    "type": "string"
                  }
                },
                "required": ["dateOfDeath", "firstName", "guid", "isArchived", "lastName"],
                "type": "object"
              },
              "domainType": {
                "enum": ["person"],
                "type": "string"
              },
              "frontendUrl": {
                "type": "string"
              },
              "icon": {
                "description": "user for an ordinary person; user-shield for a censored person placeholder.",
                "enum": ["user", "user-shield"],
                "example": "user",
                "type": "string"
              },
              "infos": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": ["frontendUrl", "domainAttributes", "domainType", "icon", "infos", "apiUrl"],
            "type": "object"
          }
        ],
        "description": "Person as Domain Object"
      },
      "FileMetaData": {
        "properties": {
          "createdDate": {
            "$ref": "#/components/schemas/ZuluDate"
          },
          "createdPerson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetaDataPersonId"
              },
              {
                "$ref": "#/components/schemas/DomainObjectPerson"
              }
            ]
          },
          "modifiedDate": {
            "$ref": "#/components/schemas/ZuluDate"
          },
          "modifiedPerson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetaDataPersonId"
              },
              {
                "$ref": "#/components/schemas/DomainObjectPerson"
              }
            ]
          }
        },
        "required": ["createdDate", "createdPerson", "modifiedDate", "modifiedPerson"],
        "type": "object"
      },
      "MetaCount": {
        "properties": {
          "count": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "MetaDataPersonId": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "ZuluDate": {
        "description": "A timestamp in Zulu time format, e.g. '2022-10-19T12:00:00Z'",
        "example": "2022-10-19T12:00:00Z",
        "format": "date-time",
        "type": "string"
      }
    },
    "securitySchemes": {
      "Login-Token-Header": {
        "description": "Format: `Login <token>`",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  }
}
