{
  "name": "presenter",
  "version": "2.5.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Marcel Birkholz",
  "homepage": "https://github.com/fbgg-de/Presenter",
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "format": "prettier --write .",
    "format:backend": "php php-cs-fixer.phar fix . --rules=@PSR12 --using-cache=no",
    "format:all": "npm run format:backend && npm run format",
    "lint": "eslint --cache .",
    "typesafe-i18n": "typesafe-i18n --no-watch",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev:frontend": "electron-vite dev --mode dev",
    "dev:backend": "php -S localhost:8000 -t ./",
    "dev:web": "vite dev --config vite.config.ts",
    "dev": "concurrently -k -n \"i18n,frontend,backend\" -c \"yellow.bold,cyan.bold,magenta.bold\" \"typesafe-i18n\" \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "npm run typesafe-i18n && npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:web": "npm run typesafe-i18n && vite build --config vite.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "publish:win": "npm run build && electron-builder --win --publish=always",
    "reinstall-electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "electron-updater": "^6.8.6",
    "font-list": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "qrcode.react": "^4.2.0",
    "react-colorful": "^5.7.0",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "typesafe-i18n": "^5.27.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.11.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
