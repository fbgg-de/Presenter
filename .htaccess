Options -MultiViews
RewriteEngine On

# Handle REST API calls
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rest/(.*)$ rest.php/$1 [L]

# Handle OIDC flow — rewrite /oidc to oidc.php (no conditions needed, /oidc is never a real file)
RewriteRule ^oidc$ oidc.php [L,QSA]
RewriteRule ^oidc/(.*)$ oidc.php/$1 [L,QSA]

RewriteRule ^login$ login.html [L,QSA]
RewriteRule ^login/(.*)$ login.html [L,QSA]
RewriteRule ^admin$ admin.html [L,QSA]
RewriteRule ^admin/(.*)$ admin.html [L,QSA]
RewriteRule ^notes$ musician.html [L,QSA]
RewriteRule ^control$ control.html [L,QSA]
RewriteRule ^message$ message.html [L,QSA]

# Protect data, cache and log directories from direct access
RewriteRule ^data/ - [F,L]
RewriteRule ^cache/ - [F,L]
RewriteRule ^logs/ - [F,L]


# Handle React Router (HTML5 History Mode)
# Don't rewrite if file or directory exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Don't rewrite PHP files, assets, installers, OIDC, or special HTML pages (a missing installer
# is a 404, not the app downloaded under the installer's name)
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/app/
RewriteCond %{REQUEST_URI} !^/oidc
RewriteCond %{REQUEST_URI} !^/admin\.html
RewriteCond %{REQUEST_URI} !^/login\.html
RewriteCond %{REQUEST_URI} !^/musician\.html
RewriteCond %{REQUEST_URI} !^/control\.html
RewriteCond %{REQUEST_URI} !^/message\.html
RewriteCond %{REQUEST_URI} !^/presentation\.html
# Rewrite everything else to index.html for React Router
RewriteRule ^(.*)$ index.html [L]

# Built files carry a hash of their content in the name, so a browser may keep them for good —
# the PowerPoint renderer alone is several megabytes. A new build has new names.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Every log file, rotated copies included (error.1.log, see classes/Logging.php)
<FilesMatch "\.log$">


  Require all denied
</FilesMatch>

<Files "config.php">
  Require all denied
</Files>

# Shipped so a fresh deployment can bootstrap its database — imported from the shell,
# never served.
<Files "install.sql">
  Require all denied
</Files>
